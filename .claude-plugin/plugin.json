{
  "name": "herdr-panorama",
  "displayName": "herdr panorama",
  "version": "0.2.0",
  "description": "Opt-in companion for the herdr-panorama swarm view: records subagent start/stop (its report_thread MCP tool is deprecated and does nothing)",
  "author": {
    "name": "LeaveMyYard"
  },
  "repository": "https://github.com/LeaveMyYard/herdr-panorama",
  "license": "MIT",
  "keywords": [
    "herdr",
    "swarm",
    "subagents",
    "mcp"
  ],
  "mcpServers": {
    "herdr-panorama": {
      "command": "sh",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/mcp",
        "${CLAUDE_PLUGIN_ROOT}",
        "mcp"
      ],
      "env": {
        "UV_PROJECT_ENVIRONMENT": "${CLAUDE_PLUGIN_DATA}/venv-0.2.0"
      }
    }
  }
}
