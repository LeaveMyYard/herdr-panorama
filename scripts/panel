# herdr-panorama: a per-tab panel's launcher (docs/plans/rust-rewrite.md §5.4; POSIX sh).
#
#   sh scripts/panel        the manifest's `panel` pane and herdr.PANEL_COMMAND
#
# It runs the Rust viewer only when it is there AND speaks this checkout's panel contract:
# `panorama contract` prints the number of the panel contract it implements (the `panel`
# subcommand, the core protocol's major, the plugin environment it reads, the crash marker),
# and this script carries the number the Python core next to it expects. A binary that is
# stale (from before `panel`), fails to start (126/127), panics, or does not answer within
# 2 s is passed over, so the panel never dies at start for it. The candidates, in order:
#   1. ${CARGO_TARGET_DIR}/release/panorama, when CARGO_TARGET_DIR is set;
#   2. <plugin root>/target/release/panorama (`cargo build --release` in a linked checkout).
# Otherwise the venv's viewer (the plugin's build ran `uv sync`), and `uv run` without one.
# A binary that is there but does not match is reported on stderr and in
# <state dir>/panel-launch.log (the latest only), so a silent fallback to Python can be noticed.
CONTRACT=1

R=${HERDR_PLUGIN_ROOT:-.}

# Prints what `$1 contract` says, given at most 2 s (timeout(1), else perl's alarm).
contract_of() {
	if command -v timeout >/dev/null 2>&1; then
		timeout 2 "$1" contract
	elif command -v perl >/dev/null 2>&1; then
		perl -e 'alarm shift; exec @ARGV or exit 127' 2 "$1" contract
	else
		"$1" contract
	fi </dev/null 2>/dev/null
}

for B in ${CARGO_TARGET_DIR:+"$CARGO_TARGET_DIR/release/panorama"} "$R/target/release/panorama"; do
	[ -f "$B" ] && [ -x "$B" ] || continue
	got=$(contract_of "$B")
	if [ "$got" = "$CONTRACT" ]; then
		exec "$B" panel
	fi
	msg="panorama: $B speaks panel contract '${got:-none}', this checkout needs $CONTRACT: using the Python viewer"
	printf '%s\n' "$msg" >&2
	if [ -n "${HERDR_PLUGIN_STATE_DIR:-}" ]; then
		printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$msg" >"$HERDR_PLUGIN_STATE_DIR/panel-launch.log" 2>/dev/null
	fi
done
[ -f "$R/.venv/bin/panorama" ] && [ -x "$R/.venv/bin/panorama" ] && exec "$R/.venv/bin/panorama" panel
exec uv run --quiet --frozen --no-dev --project "$R" panorama panel
