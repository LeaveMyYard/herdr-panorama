# herdr-panorama: a per-tab panel's launcher (docs/plans/rust-rewrite.md §5.4; POSIX sh).
#
#   sh scripts/panel        the manifest's `panel` pane and herdr.PANEL_COMMAND
#
# It runs the Rust viewer only when this plugin root has one built (target/release/panorama,
# from `cargo build --release` in a linked checkout) AND it speaks this checkout's panel
# contract: `panorama contract` prints the number of the panel contract it implements (the
# `panel` subcommand, the core protocol's major, the plugin environment it reads, the crash
# marker), and this script carries the number the Python core next to it expects. Otherwise
# the venv's viewer (the plugin's build ran `uv sync`), and `uv run` without one.
#
# Only the plugin root's own build counts. CARGO_TARGET_DIR is not looked at: it is often one
# target dir shared by every checkout, so it would run whichever checkout built last. A dev
# setup with CARGO_TARGET_DIR set (or `build.target-dir` in ~/.cargo/config.toml) gets the
# venv's viewer unless it builds here: `cargo build --release --target-dir target` in the
# plugin root (that flag beats both), or links target/release/panorama.
#
# The probe: stdin from /dev/null, its answer written to a file (a child it leaves behind
# holding the output cannot keep the panel waiting), and at most 2 s (`timeout -k 1 2`: TERM,
# then KILL a second later; perl's alarm where timeout(1) is missing). A binary that is stale
# (from before `panel`), fails to start, panics, hangs or speaks another contract is passed
# over, said on stderr and in <state dir>/panel-launch.log (the latest fallback; a later start
# that runs the Rust viewer removes it). The probe still
# reaches the pane's terminal (no setsid: not on macOS); a binary that passes gets it anyway.
# While it runs (about 10 ms; at most 3 s) the pane answers "not a panel" to `process-info`
# (the core places its own panels by id, so only a + New agent tab's panel is in that window).
CONTRACT=1

R=${HERDR_PLUGIN_ROOT:-.}
B="$R/target/release/panorama"

# What `$B contract` says, or nothing.
contract_of() {
	out=$(mktemp "${TMPDIR:-/tmp}/panorama-contract.XXXXXX") || return
	if command -v timeout >/dev/null 2>&1; then
		timeout -k 1 2 "$B" contract
	elif command -v perl >/dev/null 2>&1; then
		perl -e 'alarm shift; exec @ARGV or exit 127' 2 "$B" contract
	else
		"$B" contract
	fi </dev/null >"$out" 2>/dev/null
	head -n 1 "$out"
	rm -f "$out"
}

if [ -f "$B" ] && [ -x "$B" ]; then
	got=$(contract_of)
	if [ "$got" = "$CONTRACT" ]; then
		[ -n "${HERDR_PLUGIN_STATE_DIR:-}" ] && rm -f "$HERDR_PLUGIN_STATE_DIR/panel-launch.log"
		exec "$B" panel
	fi
	msg="panorama: $B speaks panel contract '${got:-none}', this checkout needs $CONTRACT: using the Python viewer"
	printf '%s\n' "$msg" >&2
	if [ -n "${HERDR_PLUGIN_STATE_DIR:-}" ]; then
		printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$msg" >"$HERDR_PLUGIN_STATE_DIR/panel-launch.log" 2>/dev/null
	fi
fi
[ -f "$R/.venv/bin/panorama" ] && [ -x "$R/.venv/bin/panorama" ] && exec "$R/.venv/bin/panorama" panel
exec uv run --quiet --frozen --no-dev --project "$R" panorama panel
