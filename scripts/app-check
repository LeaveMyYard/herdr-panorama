#!/usr/bin/env python3
"""Check every panorama runtime mod using isolated app/core state."""
import argparse
import shutil
import subprocess
import sys
from pathlib import Path

sys.dont_write_bytecode = True
root = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(root / 'app' / 'installer'))
from check import check_mods

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--checker')
parser.add_argument('--checker-core', choices=('managed', 'none'), default='managed',
                    help='none requires an explicit standalone custom checker that never starts a core')
args = parser.parse_args()
if args.checker_core == 'none' and not args.checker:
    parser.error('--checker-core none requires an explicit standalone --checker')
try:
    subprocess.run([sys.executable, str(root / 'scripts/app-build'), '--check'], check=True)
    check_mods(sorted((root / 'app' / 'mods').iterdir()), args.checker or shutil.which('herdr-app') or '', args.checker_core)
except (OSError, ValueError, subprocess.TimeoutExpired) as error:
    parser.exit(1, str(error) + '\n')
print('All panorama native mod checks passed.')
