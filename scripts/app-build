#!/usr/bin/env python3
"""Build self-contained native mod bundles from one owned shared source."""
import argparse
import json
from pathlib import Path
import re
import sys

root = Path(__file__).resolve().parents[1]
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--check', action='store_true', help='refuse missing or stale generated copies')
args = parser.parse_args()
errors = []
for manifest in sorted((root / 'app/mods').glob('panorama*/bundle.json')):
    data = json.loads(manifest.read_text())
    if (not isinstance(data, dict) or set(data) != {'shared'} or not isinstance(data['shared'], list)
            or not all(isinstance(name, str) for name in data['shared']) or len(set(data['shared'])) != len(data['shared'])):
        parser.exit(1, f'Invalid bundle manifest: {manifest}\n')
    requested = set(data['shared'])
    for name in data['shared']:
        if not isinstance(name, str) or not re.fullmatch(r'[a-z][a-z0-9-]*\.js', name):
            parser.exit(1, f'Unsafe shared module: {name}\n')
        source = root / 'app/shared' / name
        text = source.read_text()
        imports = set(re.findall(r'''from\s+['"]\./([^'"]+)['"]''', text))
        if not imports <= requested:
            parser.exit(1, f'Missing shared dependencies for {name}: {sorted(imports - requested)}\n')
        content = f'// Generated from app/shared/{name} by scripts/app-build.\n' + text
        target = manifest.parent / name
        if target.is_symlink():
            parser.exit(1, f'Refusing generated symlink: {target}\n')
        if args.check:
            if not target.is_file() or target.read_text() != content:
                errors.append(str(target.relative_to(root)))
        else:
            target.write_text(content)
if errors:
    parser.exit(1, 'Stale native bundles; run scripts/app-build:\n' + '\n'.join(errors) + '\n')
print('Native bundles match shared source.' if args.check else 'Built self-contained native bundles.')
