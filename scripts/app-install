#!/usr/bin/env python3
"""Install/uninstall only the panorama app flavour; never select a layout."""
import sys
from pathlib import Path

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'app' / 'installer'))
from main import main

if __name__ == '__main__':
    raise SystemExit(main())
