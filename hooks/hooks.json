{
  "description": "herdr-panorama: record subagent start/stop for the swarm view; SessionStart: one line about report_thread (inside herdr, once per session). hooks/run-hook.sh runs the plugin root's Rust binary when it is built and speaks the Claude-side contract (panorama contract claude), else stdlib Python directly (the interpreter behind python3 is resolved once and cached in CLAUDE_PLUGIN_DATA, skipping version-manager shims); always exits 0.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "-c",
              "sh \"$0\" \"$1\" session-start 2>/dev/null; exit 0",
              "${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.sh",
              "${CLAUDE_PLUGIN_ROOT}/src/herdr_panorama/hooks.py"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": ".+",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "-c",
              "sh \"$0\" \"$1\" subagent-start >/dev/null 2>&1; exit 0",
              "${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.sh",
              "${CLAUDE_PLUGIN_ROOT}/src/herdr_panorama/hooks.py"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": ".+",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "-c",
              "sh \"$0\" \"$1\" subagent-stop >/dev/null 2>&1; exit 0",
              "${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.sh",
              "${CLAUDE_PLUGIN_ROOT}/src/herdr_panorama/hooks.py"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
